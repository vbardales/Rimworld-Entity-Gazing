<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Regarder l'entite qu'on garde en cage, en loisir.

       LE CONSTAT DE DEPART : le DLC Anomaly ne contient **aucun** contenu de loisir. Pas un
       `joyKind`, pas un `JoyGiverDef`, pas un `JoyKindDef` dans tout le DLC - verifie par
       balayage. On capture des horreurs, on les sangle sur une plateforme au milieu de la base,
       on les etudie... et personne ne les regarde jamais. C'est le trou que ce mod comble.

       LE TYPE EST NEUF, ET C'EST L'INTERET. Le jeu de base n'offre que dix types de loisir dont
       quatre issus d'un batiment ; les attentes en reclament jusqu'a six differents et la
       tolerance se compte par type. Un onzieme vaut donc bien plus qu'un dixieme batiment sur un
       type deja servi - et celui-ci ne coute rien de plus qu'une plateforme qu'on avait deja
       construite pour l'etude.

       LA DISTANCE D'OBSERVATION EST LE VRAI REGLAGE, et elle est volontairement courte : 2 a 6
       cases. La nociosphere porte un `CompProperties_CauseHediff_AoE` qui applique `PainField`
       dans un rayon de 5,9. Autrement dit, une bonne partie des spectateurs se tiendra DANS son
       champ de douleur. Ce n'est pas un oubli : le prix du spectacle sort d'un mecanisme vanilla
       existant, sans une ligne de code, et il varie selon l'entite - un ver de chair ne fait
       souffrir personne. Rallonger la fourchette suffit a rendre l'activite inoffensive.

       AUCUNE PENSEE N'EST ACCORDEE. Elle serait a double tranchant : positive, elle recompenserait
       de contempler une abomination ; negative, elle transformerait une source de loisir en
       source de malus. La joie gagnee est deja la recompense, et le champ de douleur deja le prix.
       C'est une ligne a ajouter si l'envie vient.

       `MayRequire` PLUTOT QU'UN PATCH GARDE : la regle du depot vise les mods du Workshop et leur
       suffixe `_steam`, qui echappe a `MayRequire`. Anomaly est un DLC, son packageId est fixe, et
       c'est ainsi que le jeu de base s'y prend lui-meme. -->

  <JoyKindDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>EG_EntityGazing</defName>
    <label>entity gazing</label>
  </JoyKindDef>

  <JobDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>EG_WatchEntity</defName>
    <!-- Le pilote vanilla, sans derivation : une plateforme de retention EST un `Building`, il
         n'y a donc rien a retyper - a la difference de l'arbre anima, qui est une `Plant` et
         faisait exploser le cast de `JobDriver_SitFacingBuilding`. -->
    <driverClass>JobDriver_WatchBuilding</driverClass>
    <reportString>watching the contained entity.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>5</joyMaxParticipants>
    <joyKind>EG_EntityGazing</joyKind>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JoyGiverDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>EG_WatchEntity</defName>
    <giverClass>EntityGazing.JoyGiver_WatchEntity</giverClass>
    <baseChance>2</baseChance>
    <!-- `desireSit` a false : on ne tire pas une chaise devant une cage a horreurs, on reste
         debout, pret a partir. -->
    <desireSit>false</desireSit>
    <thingDefs>
      <li>HoldingPlatform</li>
    </thingDefs>
    <jobDef>EG_WatchEntity</jobDef>
    <joyKind>EG_EntityGazing</joyKind>
    <!-- La vue seule. Un aveugle n'a rien a faire la, et les mains ne servent a rien : on ne
         touche surtout pas. -->
    <requiredCapacities>
      <li>Sight</li>
    </requiredCapacities>
  </JoyGiverDef>

</Defs>
