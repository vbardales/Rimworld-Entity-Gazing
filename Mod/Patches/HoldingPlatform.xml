<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Making the holding platform watchable.

       The `joyKind` on a building is only a LABEL - it is the `JoyGiverDef` that makes the thing
       usable. But both are needed: without `joyKind` the platform does not show up as a recreation
       source in the interface, and without `watchBuildingStandDistanceRange`,
       `WatchBuildingUtility.CalculateWatchCells` finds no cell to stand in and the job fails
       silently.

       MIND THE TWO DIFFERENT XPATHS, and this is the only subtlety in the file:
       `HoldingPlatform` already has a `<statBases>` - adding a second one at the root would create
       two sibling nodes, and the game would read only one. So we add INSIDE the existing node. The
       `<building>`, on the other hand, does not exist on this def: we create it at the root, and
       inheritance will merge it with the parent's, since `<building>` merges by child name
       (unlike lists of `<li>`, which replace).

       `<placeWorkers>` is absent from the def and from every one of its parents: creating it
       therefore overwrites nothing. It draws the watch area at build time, without which the
       distance range would be invisible to the player. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HoldingPlatform"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="HoldingPlatform"]/statBases</xpath>
          <value>
            <JoyGainFactor>1</JoyGainFactor>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="HoldingPlatform"]</xpath>
          <value>
            <socialPropernessMatters>true</socialPropernessMatters>
            <building>
              <joyKind>EG_EntityGazing</joyKind>
              <!-- Short on purpose: a nociosphere applies `PainField` within a radius of 5.9. Part
                   of the audience will therefore be standing in its pain field, which is the price
                   of the show - and it comes out of a vanilla mechanic, not a line of our own
                   code. -->
              <watchBuildingStandDistanceRange>2~6</watchBuildingStandDistanceRange>
              <watchBuildingStandRectWidth>5</watchBuildingStandRectWidth>
            </building>
            <placeWorkers>
              <li>PlaceWorker_WatchArea</li>
            </placeWorkers>
            <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
