<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Entity Gazing - Pickle tests</name>
  <author>Nelim</author>
  <packageId>nelim.entitygazing.pickletests</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>In-game acceptance tests for Entity Gazing. Development only; never published.</description>
  <modDependencies>
    <li>
      <packageId>nelim.entitygazing</packageId>
      <displayName>Entity Gazing</displayName>
    </li>
    <li>
      <packageId>rimworks.pickle</packageId>
      <displayName>Pickle</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/3791648678</steamWorkshopUrl>
    </li>
  </modDependencies>
  <!-- Anomaly is deliberately NOT a dependency of this companion, only a loadAfter. The mod under
       test does require it, and says so; this suite has to run on both sides of that. The
       sans-anomaly pass exists precisely to load the game with the DLC switched off, and a
       companion that declared it would be staged asking for a DLC the pass has removed. -->
  <loadAfter>
    <li>nelim.entitygazing</li>
    <li>rimworks.pickle</li>
    <li>Ludeon.RimWorld.Anomaly</li>
  </loadAfter>
</ModMetaData>
